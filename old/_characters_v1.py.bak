def usagi():
    h = 84
    mv = make_normals(h, power=1.0, reach=1.25, speed=1.05, fx="stick", weapon="stick")
    mv.update({
        "nspec": {"frames": 34, "anim": "spit",
                  "proj": [(f, {"kind": "seed", "vx": 15, "vy": 0, "grav": 0, "r": 10, "dmg": 3,
                                "ang": 30, "bkb": 12, "kbg": 20, "life": 48}) for f in (8, 14, 20)]},
        "sspec": {"frames": 54, "anim": "crazy", "side_once": True, "drift": [(8, 40, 15, 0)], "grav": 0.2,
                  "hits": [_hb((8, 40), 20, 0, 34, 2.5, 50, 25, 10, rehit=7, fx="spin"),
                           _hb((44, 47), 30, 0, 38, 6, 40, 55, 90, grp=2, fx="big")]},
        "uspec": {"frames": 40, "anim": "rise", "helpless": True, "drift": [(5, 5, None, -21)], "steer": 0.6,
                  "hits": [_hb((5, 12), 0, -24, 30, 9, 88, 55, 70, fx="arc_up")]},
        "dspec": {"frames": 60, "anim": "eat", "heal": (40, 6), "cooldown": 360},
    })
    return {"name": "Usagi", "image": "usagi", "color": (245, 208, 76), "w": 58, "h": h, "weight": 86,
            "run": 11.2, "walk": 5.6, "air": 7.6, "accel": 0.5, "grav": 0.62, "fall": 9.8, "ff": 15.0,
            "jump": 15.6, "hop": 10.6, "djump": 15.0, "jumps": 2, "moves": mv,
