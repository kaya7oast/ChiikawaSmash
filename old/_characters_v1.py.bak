"""
Character stats + move data (pure data, no pygame).

Move format (all frame numbers are 60 fps frames, counted from 1):
  frames   total length of the move
  hits     list of hitboxes: f=(first, last) active frames, x/y offset from the fighter's centre
           (x is FORWARD, y is DOWN), r radius, dmg, ang (0 = forward, 90 = up, 180 = back, 270 = down),
           bkb (base knockback), kbg (knockback growth), grp (hit once per group), rehit (multi-hit every n frames),
           radial (launch away from the fighter instead of using ang)
  land     landing lag if you land during this aerial
  drift    [(first, last, vx, vy)] set velocity during frames (vx is forward; None = leave alone)
  grav     gravity multiplier during the move
  steer    how much air control you keep (1 = full aerial drift)
  charge   smash attacks: frame where holding the button charges (up to 1s, up to +40% damage)
  proj     [(frame, {projectile data})]
  helpless after the move you fall helplessly (up-specials)
  next     jab combo: (name, first frame you can continue from)
  side_once  (side specials) only once per trip into the air
  cooldown frames before you can use it again
  counter  (first, last) frames: getting hit triggers the counter move instead
  heal / buff  (frame, amount)
  land_move   move that plays if you touch the ground during this move
  glide    after the move, glide instead of falling helplessly
  anim     how the renderer animates the body; fx = how attack swooshes look
"""
import copy

STD_H = 70.0  # hitbox numbers below are written for a 70px-tall fighter


def _hb(f, x, y, r, dmg, ang, bkb, kbg, **kw):
    d = {"f": f, "x": x, "y": y, "r": r, "dmg": dmg, "ang": ang, "bkb": bkb, "kbg": kbg}
    d.update(kw)
    return d


def base_normals(fx="swipe"):
    """The shared Smash-style move list. Characters scale and override it."""
    return {
        "jab1": {"frames": 16, "anim": "jab", "next": ("jab2", 6),
                 "hits": [_hb((3, 4), 42, -4, 20, 2.5, 18, 8, 20, fx="poke")]},
        "jab2": {"frames": 16, "anim": "jab2", "next": ("jab3", 6),
                 "hits": [_hb((3, 4), 44, -4, 20, 2.0, 18, 8, 20, fx="poke")]},
        "jab3": {"frames": 30, "anim": "jab3",
                 "hits": [_hb((4, 6), 52, -6, 26, 4.5, 40, 40, 90, fx=fx)]},
        "ftilt": {"frames": 30, "anim": "ftilt",
                  "hits": [_hb((6, 8), 58, -4, 26, 9, 38, 30, 88, fx=fx)]},
        "utilt": {"frames": 28, "anim": "utilt",
                  "hits": [_hb((5, 10), 12, -52, 30, 7, 93, 35, 110, fx="arc_up")]},
        "dtilt": {"frames": 22, "anim": "dtilt",
                  "hits": [_hb((5, 7), 52, 24, 22, 6, 78, 30, 60, fx="poke")]},
        "dash": {"frames": 38, "anim": "dash", "drift": [(1, 14, 9, None)],
                 "hits": [_hb((6, 12), 38, -2, 28, 10, 52, 40, 80, fx="dash"),
                          _hb((13, 16), 38, -2, 24, 6, 60, 35, 60, fx="dash")]},
        "fsmash": {"frames": 50, "anim": "fsmash", "charge": 8,
                   "hits": [_hb((15, 17), 66, -4, 32, 16, 38, 30, 100, fx="big")]},
        "usmash": {"frames": 46, "anim": "usmash", "charge": 6,
                   "hits": [_hb((11, 15), 4, -62, 36, 15, 88, 32, 98, fx="arc_up")]},
        "dsmash": {"frames": 48, "anim": "dsmash", "charge": 5,
                   "hits": [_hb((10, 12), 52, 20, 28, 14, 30, 30, 95, fx="ground"),
                            _hb((10, 12), -52, 20, 28, 14, 150, 30, 95, fx="ground")]},
        "nair": {"frames": 40, "anim": "nair", "land": 7,
                 "hits": [_hb((5, 8), 0, 0, 40, 8, 45, 25, 85, grp=1, fx="spin"),
                          _hb((9, 20), 0, 0, 36, 5, 45, 15, 70, grp=1, fx="spin")]},
        "fair": {"frames": 40, "anim": "fair", "land": 14,
                 "hits": [_hb((10, 13), 50, -4, 28, 12, 40, 30, 95, fx=fx)]},
        "bair": {"frames": 36, "anim": "bair", "land": 11,
                 "hits": [_hb((7, 10), -48, -2, 28, 13, 145, 30, 100, fx="kick")]},
        "uair": {"frames": 32, "anim": "uair", "land": 8,
                 "hits": [_hb((5, 9), 0, -52, 32, 9, 85, 25, 105, fx="arc_up")]},
        "dair": {"frames": 44, "anim": "dair", "land": 18,
                 "hits": [_hb((12, 15), 0, 42, 28, 13, 275, 25, 80, fx="stomp")]},
        "grab": {"frames": 30, "anim": "grab", "grabbox": ((6, 8), 44, -4, 26)},
        "pummel": {"frames": 18, "anim": "pummel", "pummel": (4, 1.5)},
        "fthrow": {"frames": 30, "anim": "fthrow", "throw": (10, 8, 40, 50, 70)},       # (frame, dmg, ang, bkb, kbg)
        "bthrow": {"frames": 34, "anim": "bthrow", "throw": (12, 10, 140, 55, 75)},
        "uthrow": {"frames": 34, "anim": "uthrow", "throw": (12, 7, 90, 60, 70)},
        "dthrow": {"frames": 30, "anim": "dthrow", "throw": (11, 6, 72, 45, 55)},
        "getup": {"frames": 34, "anim": "ftilt", "intang": (1, 16),
                  "hits": [_hb((16, 19), 46, 0, 30, 7, 40, 45, 30, fx=fx)]},
    }


def make_normals(h, power=1.0, reach=1.0, speed=1.0, fx="swipe", weapon=None):
    s = h / STD_H
    moves = base_normals(fx)
    for name, m in moves.items():
        if speed != 1.0 and name not in ("pummel",):
            m["frames"] = max(8, round(m["frames"] / speed))
            for hb in m.get("hits", []):
                a, b = hb["f"]
                hb["f"] = (max(1, round(a / speed)), max(1, round(b / speed)))
            if "grabbox" in m:
                (a, b), x, y, r = m["grabbox"]
                m["grabbox"] = ((max(1, round(a / speed)), max(1, round(b / speed))), x, y, r)
        for hb in m.get("hits", []):
            hb["x"] *= s * reach
            hb["y"] *= s
            hb["r"] *= s * (0.5 + 0.5 * reach)
            hb["dmg"] = round(hb["dmg"] * power, 1)
        if "grabbox" in m:
            f, x, y, r = m["grabbox"]
            m["grabbox"] = (f, x * s, y * s, r * s)
        if weapon:
            m.setdefault("weapon", weapon)
    return moves


# ---------------------------------------------------------------- characters
def chiikawa():
    h = 64
    mv = make_normals(h, power=0.95, reach=0.95, speed=1.08, fx="swipe")
    mv.update({
        "nspec": {"frames": 36, "anim": "throw_fwd",
                  "proj": [(12, {"kind": "weed", "vx": 8.5, "vy": -7, "grav": 0.38, "r": 16, "dmg": 7,
                                 "ang": 45, "bkb": 30, "kbg": 50, "life": 110})]},
        "sspec": {"frames": 40, "anim": "charge", "side_once": True, "drift": [(8, 22, 13, 0)], "grav": 0.3,
                  "hits": [_hb((8, 22), 26, 0, 28, 10, 40, 45, 70, fx="dash")]},
        "uspec": {"frames": 34, "anim": "rise", "helpless": True, "drift": [(4, 4, None, -17.5)], "steer": 0.6,
                  "hits": [_hb((4, 14), 0, -18, 32, 8, 85, 50, 60, fx="spin")]},
        "dspec": {"frames": 42, "anim": "cry", "counter": (5, 26), "grav": 0.5},
        "counter_hit": {"frames": 30, "anim": "fsmash", "intang": (1, 8),
                        "hits": [_hb((4, 7), 40, -4, 40, 0, 40, 60, 80, fx="big", counter=True)]},
    })
    return {"name": "Chiikawa", "image": "chiikawa", "color": (238, 130, 158), "w": 56, "h": h, "weight": 82,
            "run": 9.6, "walk": 5.0, "air": 6.6, "accel": 0.42, "grav": 0.56, "fall": 9.0, "ff": 14.0,
            "jump": 14.4, "hop": 10.0, "djump": 13.6, "jumps": 2, "moves": mv,
            "desc": "Small but brave. Weed toss, brave charge, big hop, cry counter."}


